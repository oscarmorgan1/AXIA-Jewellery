rules_version = '2';

// AXIA Firestore security rules.
//
//   products/{id}        public catalogue: anyone can read, only admins write
//   productCosts/{id}    PRIVATE factory costs and margins: admins only
//   internal/{doc}       PRIVATE cost assumptions, launch plan: admins only
//   collections/{slug}   public: anyone can read, only admins write
//   signups/{id}         waitlist sign-ups: written by the server, only admins read
//   messages/{id}        support form: written by the server, only admins read
//   visits/{day_vid}     anonymous unique-visitor counts: written by the server, only admins read
//   site/{doc}           public site settings (launch countdown): anyone reads, only admins write
//   orders/{id}          admins only (Stripe webhooks will write via the Admin SDK)
//   pieces/{key}         PRIVATE piece registry (serial, supplier, order): admins only.
//                        The public /genuine check never reads it from the browser: it
//                        goes through the server (server/genuine.js), which returns only
//                        the product name and the customer's purchase date for one sold serial.
//   suppliers/{id}       PRIVATE manufacturers and suppliers: admins only
//
// "Admin" means a signed-in user whose ID token carries the custom claim
// admin == true (set with `npm run set-admin -- <email>`) AND who has entered
// the code emailed to them for this sign-in: the server adds the token's
// auth_time to the `mfa` claim once the code checks out (server/twofactor.js).
// adminSignInCodes/{uid} holds those codes (hashed); only the server touches it.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true
        && request.auth.token.get('mfa', []) is list
        && request.auth.token.auth_time in request.auth.token.get('mfa', []);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasAll(['id', 'name'])
        && request.resource.data.id == productId
        // cost/economics fields must never land in the public collection
        && !request.resource.data.keys().hasAny(['economics', 'factory_cost_AUD', 'factoryCostAUD', 'cost']);
      allow delete: if isAdmin();
    }

    match /collections/{slug} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.slug == slug
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow delete: if isAdmin();
    }

    // Public forms (waitlist sign-ups, support messages, visitor counts) are
    // written by the server through the Admin SDK (server/signup.js, server/forms.js),
    // which validates and rate limits them. Browsers can't write here directly.
    match /signups/{id} {
      allow read, update, delete: if isAdmin();
    }

    match /messages/{id} {
      allow read, update, delete: if isAdmin();
    }

    match /productCosts/{productId} {
      allow read, write: if isAdmin();
    }

    match /internal/{docId} {
      allow read, write: if isAdmin();
    }

    // Unique visitors: one anonymous entry per browser per day, id "{day}_{vid}",
    // written by the server (POST /api/visit).
    match /visits/{id} {
      allow read, delete: if isAdmin();
    }

    // Public site settings edited in the portal (e.g. site/countdown).
    // Never put anything private here: the whole collection is world-readable.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin()
        && !request.resource.data.keys().hasAny(['economics', 'factory_cost_AUD', 'factoryCostAUD', 'cost']);
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    // One physical piece, keyed by its serial in capitals with only letters and
    // digits (serialKey() in admin-portal/src/lib/pieces.ts and server/genuine.js).
    // No public read, get or list: serials, suppliers and orders stay private.
    match /pieces/{key} {
      function validPiece() {
        let d = request.resource.data;
        return key.matches('^[A-Z0-9]{1,40}$')
          && d.key == key
          && d.serial is string && d.serial.size() > 0 && d.serial.size() <= 40
          && d.productId is string && d.productId.size() > 0
          && d.productName is string
          && d.purchasedOn is string && d.purchasedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (d.get('shippedOn', null) == null
              || (d.shippedOn is string && d.shippedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (d.get('receivedOn', null) == null
              || (d.receivedOn is string && d.receivedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (d.get('supplierOrderNo', '') is string && d.get('supplierOrderNo', '').size() <= 80)
          && (d.get('orderId', null) == null || d.orderId is string);
      }
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && validPiece();
      // the serial is the record: it can't be changed in place
      allow update: if isAdmin() && validPiece() && request.resource.data.serial == resource.data.serial;
    }

    match /suppliers/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120;
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
