rules_version = '2';

// AXIA Firestore security rules.
//
//   products/{id}        public catalogue: anyone can read, only admins write
//   productCosts/{id}    PRIVATE factory costs and margins: admins only
//   internal/{doc}       PRIVATE cost assumptions, launch plan: admins only
//   collections/{slug}   public: anyone can read, only admins write
//   signups/{id}         waitlist sign-ups: written by the server, only admins read
//   messages/{id}        support form: written by the server, only admins read
//   visits/{day_vid}     anonymous unique-visitor counts: written by the server, only admins read
//   site/{doc}           public site settings (launch countdown): anyone reads, only admins write
//   orders/{id}          admins only (Stripe webhooks will write via the Admin SDK)
//
// "Admin" means a signed-in user whose ID token carries the custom claim
// admin == true (set with `npm run set-admin -- <email>`).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasAll(['id', 'name'])
        && request.resource.data.id == productId
        // cost/economics fields must never land in the public collection
        && !request.resource.data.keys().hasAny(['economics', 'factory_cost_AUD', 'factoryCostAUD', 'cost']);
      allow delete: if isAdmin();
    }

    match /collections/{slug} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.slug == slug
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow delete: if isAdmin();
    }

    // Public forms (waitlist sign-ups, support messages, visitor counts) are
    // written by the server through the Admin SDK (server/signup.js, server/forms.js),
    // which validates and rate limits them. Browsers can't write here directly.
    match /signups/{id} {
      allow read, update, delete: if isAdmin();
    }

    match /messages/{id} {
      allow read, update, delete: if isAdmin();
    }

    match /productCosts/{productId} {
      allow read, write: if isAdmin();
    }

    match /internal/{docId} {
      allow read, write: if isAdmin();
    }

    // Unique visitors: one anonymous entry per browser per day, id "{day}_{vid}",
    // written by the server (POST /api/visit).
    match /visits/{id} {
      allow read, delete: if isAdmin();
    }

    // Public site settings edited in the portal (e.g. site/countdown).
    // Never put anything private here: the whole collection is world-readable.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin()
        && !request.resource.data.keys().hasAny(['economics', 'factory_cost_AUD', 'factoryCostAUD', 'cost']);
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
