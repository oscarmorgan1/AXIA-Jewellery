rules_version = '2';

// Product photos uploaded from the admin portal live under products/, admins' own photos under admins/.
// Only admins who have entered their emailed sign-in code (see firestore.rules)
// upload, read or list them through the Storage API.
//
// The storefront still shows them to everyone: it uses download URLs (the
// ?alt=media&token=... address getDownloadURL() returns, and the one
// server/media.js makes for videos under media/, which has no rule at all).
// Those carry their own secret token, which Storage honours without running
// these rules. So nobody needs public read here, and listing or guessing paths
// with the public API key gets nothing.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true
        && request.auth.token.get('mfa', []) is list
        && request.auth.token.auth_time in request.auth.token.get('mfa', []);
    }

    match /products/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
    }
    // Each admin's own profile photo ("Manage your account"). Shown through its
    // download URL (their Firebase photoURL); only that admin, past their code, writes it.
    match /admins/{uid}/{file} {
      allow read: if isAdmin();
      allow write: if isAdmin() && request.auth.uid == uid
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
