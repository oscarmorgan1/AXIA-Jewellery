rules_version = '2';

// Product photos uploaded from the admin portal live under products/.
// Anyone can view them (they're shown on the storefront); only admins who have
// entered their emailed sign-in code (see firestore.rules) upload.
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true
        && request.auth.token.get('mfa', []) is list
        && request.auth.token.auth_time in request.auth.token.get('mfa', [])
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
