{
  "name": "axia-jewellery",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "firebase emulators:exec --project axia-jewellery --ui \"npm run seed && npm run admin:dev\"",
    "emulators": "firebase emulators:start --project axia-jewellery",
    "start": "node server/index.js",
    "serve": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 PORT=5050 node --env-file-if-exists=.env server/index.js",
    "seed": "node scripts/seed.mjs",
    "set-admin": "node scripts/set-admin.mjs",
    "export:products": "node scripts/export-products.mjs",
    "admin:dev": "npm --prefix admin-portal run dev",
    "admin:build": "npm --prefix admin-portal run build",
    "build": "npm run admin:build",
    "deploy": "firebase deploy --project axia-jewellery",
    "postinstall": "npm --prefix admin-portal install",
    "migrate:collections": "node scripts/migrate-collections.mjs",
    "images": "node scripts/images.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-axia-rules \"node --test tests/rules.test.mjs\"",
    "test": "node --test tests/sync.test.mjs tests/catalogue.test.mjs tests/csp.test.mjs",
    "test:promos": "firebase emulators:exec --only firestore --project axia-jewellery \"node --test tests/promos.test.mjs\"",
    "test:deletes": "firebase emulators:exec --only firestore,auth --project axia-jewellery \"node --test tests/deletes.test.mjs\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.10.0",
    "resend": "^6.32.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^14.19.0",
    "sharp": "^0.34.5"
  }
}
